# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# keep .env.example tracked
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent artifacts (task plans, reviews, build logs)
/.agents/tasks/*.txt
/.agents/tasks/*-review.md
/.agents/tasks/*-plan.md
/.agents/tasks/*.json
!/.agents/tasks/seo-plan.md
# keep main SEO plan tracked

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS (additional)
Thumbs.db
Desktop.ini

# Logs
logs/
*.log.*

# Temporary files
tmp/
temp/
*.tmp
.worktrees/

# Build artifacts
build-verify.txt
