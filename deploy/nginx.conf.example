# نمونه تنظیم Nginx برای radif-ecu.ir (HTTPS با certbot/Let's Encrypt)
# سپس در backend/.env: COOKIE_SECURE=true و TRUST_PROXY=2
server {
    listen 80;
    server_name radif-ecu.ir www.radif-ecu.ir;
    return 301 https://radif-ecu.ir$request_uri;
}

server {
    listen 443 ssl http2;
    server_name radif-ecu.ir;

    ssl_certificate     /etc/letsencrypt/live/radif-ecu.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/radif-ecu.ir/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
