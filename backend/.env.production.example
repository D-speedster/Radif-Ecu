# ══════════════════════════════════════════════════════════════
# Backend Production Environment Variables (Ubuntu VPS)
# این فایل را به .env تغییر نام دهید و مقادیر را پر کنید
# ══════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ─── MongoDB Atlas ──────────────────────────────────────────────────────────
# ⚠️ مهم: Connection String خود را از MongoDB Atlas بگیرید
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/radif?retryWrites=true&w=majority&appName=Cluster0

# ─── JWT ──────────────────────────────────────────────────────────────────────
# ⚠️ بسیار مهم: از یک Secret قوی و تصادفی استفاده کنید (حداقل 32 کاراکتر)
# برای تولید: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# ─── Cookie Security ──────────────────────────────────────────────────────────
# ⚠️ مهم: در Production باید true باشد
# اگر از HTTP استفاده می‌کنید (بدون SSL)، false بگذارید
# توصیه: از SSL Certificate استفاده کنید (Let's Encrypt رایگان است)
COOKIE_SECURE=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL Frontend - برای CORS allowlist
# باید با NEXT_PUBLIC_SITE_URL در Vercel مطابقت داشته باشد
CLIENT_URL=https://radif-ecu.ir

# ─── Environment ──────────────────────────────────────────────────────────────
# ⚠️ حتماً production بگذارید
NODE_ENV=production

# ─── اعلان فوری Lead به تلگرام (اختیاری) ──────────────────────────────────────
# در صورت تمایل، Bot Token و Chat ID خود را وارد کنید
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Trust Proxy ──────────────────────────────────────────────────────────────
# تعداد proxy های پشت سرور
# بدون proxy (مستقیم): 0
# Vercel → VPS: 1
# Nginx → Vercel → VPS: 2
TRUST_PROXY=1

# ─── Registration ──────────────────────────────────────────────────────────────
# ثبت‌نام عمومی (باید بسته باشد)
# ادمین را با دستور زیر بسازید: node scripts/createAdmin.js
ALLOW_REGISTRATION=false

# ══════════════════════════════════════════════════════════════════════════════
# نکات امنیتی:
# ══════════════════════════════════════════════════════════════════════════════
# 
# 1. MONGO_URI را از MongoDB Atlas Network Access بگیرید
# 2. JWT_SECRET را تصادفی و قوی بسازید
# 3. COOKIE_SECURE=true فقط با HTTPS کار می‌کند
# 4. CLIENT_URL باید دقیقاً با Domain Frontend مطابقت داشته باشد
# 5. NODE_ENV=production را فراموش نکنید
# 6. این فایل را commit نکنید (در .gitignore است)
# 7. MongoDB Atlas را از IP VPS خود Whitelist کنید
#
# ══════════════════════════════════════════════════════════════════════════════
