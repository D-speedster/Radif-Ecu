# ─── Server ──────────────────────────────────────────────────────────────────
 PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# For MongoDB Atlas (cloud) - RECOMMENDED:
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/radif?retryWrites=true&w=majority&appName=Cluster0
#
# For local development (direct connection):
# MONGO_URI=mongodb://localhost:27017/radif
#
# For Docker deployment (use the service name, not localhost):
# MONGO_URI=mongodb://mongo:27017/radif

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Use a strong random string (minimum 32 characters) in production
JWT_SECRET=replace_with_a_strong_random_secret

# ─── Cookie Security ──────────────────────────────────────────────────────────
# Set to 'true' ONLY when running behind HTTPS (SSL certificate required)
# Set to 'false' for plain HTTP (local dev, Docker without SSL)
COOKIE_SECURE=false

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of the frontend — used for CORS allowlist
# For Docker: http://YOUR_SERVER_IP:3000
# For local dev: http://localhost:3000
CLIENT_URL=http://localhost:3000

# ─── Environment ──────────────────────────────────────────────────────────────
# Use 'production' for live deployments, 'development' for local/Docker HTTP
NODE_ENV=development

# ─── اعلان فوری Lead به تلگرام (اختیاری) ──────────────────────────────────────
# ۱) در تلگرام با @BotFather یک ربات بسازید و token را بگذارید
# ۲) به ربات پیام بدهید و chat id خود را از @userinfobot بگیرید
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# تعداد proxy پشت سرور (Nginx=1). بدون proxy مقدار 0
TRUST_PROXY=1
