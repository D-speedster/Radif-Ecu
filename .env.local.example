# ══════════════════════════════════════════════════════════════
# Development Environment Variables
# این فایل را به .env.local تغییر نام دهید
# ══════════════════════════════════════════════════════════════

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API URL - مستقیم به Backend محلی
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google Tag Manager ID (در development معمولاً خالی است)
NEXT_PUBLIC_GTM_ID=

# Backend Origin - برای rewrites
BACKEND_ORIGIN=http://localhost:5000

# Internal API URL - برای Server-Side
INTERNAL_API_URL=http://localhost:5000/api
