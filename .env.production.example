# ══════════════════════════════════════════════════════════════
# Production Environment Variables (Vercel)
# این متغیرها باید در Vercel Dashboard تنظیم شوند
# ══════════════════════════════════════════════════════════════

# Site URL - دامنه اصلی سایت
NEXT_PUBLIC_SITE_URL=https://radif-ecu.ir

# API URL - مسیر نسبی برای Proxy
# ⚠️ مهم: باید /api باشد نه URL کامل
NEXT_PUBLIC_API_URL=/api

# Google Tag Manager ID
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ──────────────────────────────────────────────────────────────
# Server-Side Only Variables (در Client bundle قرار نمی‌گیرند)
# ──────────────────────────────────────────────────────────────

# Backend Origin - برای Vercel Rewrite
# ⚠️ مهم: باید IP یا Domain VPS شما باشد
# گزینه 1: استفاده از IP مستقیم
# BACKEND_ORIGIN=http://YOUR_VPS_IP:5000

# گزینه 2: استفاده از Subdomain (توصیه می‌شود)
# BACKEND_ORIGIN=https://api.radif-ecu.ir

BACKEND_ORIGIN=http://YOUR_VPS_IP:5000

# Internal API URL - برای Server-Side fetches (sitemap، SSR)
# باید مطابق با BACKEND_ORIGIN باشد
INTERNAL_API_URL=http://YOUR_VPS_IP:5000/api

# ══════════════════════════════════════════════════════════════
# نکات مهم:
# ══════════════════════════════════════════════════════════════
# 
# 1. NEXT_PUBLIC_API_URL باید /api باشد (نه URL کامل)
# 2. BACKEND_ORIGIN و INTERNAL_API_URL نباید NEXT_PUBLIC_ داشته باشند
# 3. YOUR_VPS_IP را با IP واقعی VPS خود جایگزین کنید
# 4. اگر SSL روی VPS دارید، از https استفاده کنید
# 5. اگر از Subdomain استفاده می‌کنید، DNS را تنظیم کنید
#
# ══════════════════════════════════════════════════════════════
