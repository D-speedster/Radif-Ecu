# ══════════════════════════════════════════════════════════════
# Frontend Environment Variables (Next.js)
# ══════════════════════════════════════════════════════════════

# Site URL - برای metadata، sitemap، og:url، canonical
NEXT_PUBLIC_SITE_URL=https://radif-ecu.ir

# API URL - برای client-side API requests
# ⭐ DEVELOPMENT: http://localhost:5000/api (مستقیم به Backend محلی)
# ⭐ PRODUCTION: /api (از طریق Vercel proxy به VPS)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google Tag Manager ID - برای tracking و تبلیغات
NEXT_PUBLIC_GTM_ID=

# ──────────────────────────────────────────────────────────────
# Build-time & Server-Side Variables
# ──────────────────────────────────────────────────────────────

# Backend Origin - برای rewrites در next.config.js
# ⭐ DEVELOPMENT: http://localhost:5000
# ⭐ PRODUCTION (Vercel): http://YOUR_VPS_IP:5000 یا https://api.radif-ecu.ir
# این متغیر فقط در Build-time و Server-Side استفاده می‌شود، در Client bundle قرار نمی‌گیرد
BACKEND_ORIGIN=http://localhost:5000

# Internal API URL - برای server-side requests (sitemap، SSR، generateMetadata)
# ⭐ DEVELOPMENT: http://localhost:5000/api
# ⭐ PRODUCTION (Vercel): http://YOUR_VPS_IP:5000/api یا https://api.radif-ecu.ir/api
# این متغیر فقط در Server Components استفاده می‌شود
INTERNAL_API_URL=http://localhost:5000/api

# ══════════════════════════════════════════════════════════════
# نکات:
# - این فایل را commit کنید (نه .env واقعی)
# - برای استفاده، فایل .env بسازید و مقادیر را تنظیم کنید
# - متغیرهای NEXT_PUBLIC_* در client قابل دسترسی هستند
# - متغیرهای بدون NEXT_PUBLIC_ فقط server-side هستند
# ══════════════════════════════════════════════════════════════
